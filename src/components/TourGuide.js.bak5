// src/components/TourGuide.js
import React, { useEffect, useRef, useState } from 'react';
import {
  View, Text, Pressable, Dimensions, StyleSheet, Animated,
} from 'react-native';
import { Ionicons } from '@expo/vector-icons';
import { useSafeAreaInsets } from 'react-native-safe-area-context';

import { useTheme } from '../theme';

const { width: SW, height: SH } = Dimensions.get('window');

export default function TourGuide({ steps = [], visible, onFinish, onStepChange }) {
  const insets = useSafeAreaInsets();
  const { colors } = useTheme();

  const [index, setIndex] = useState(0);
  const [layout, setLayout] = useState(null);
  const [measuring, setMeasuring] = useState(false);
  const fadeAnim = useRef(new Animated.Value(1)).current;

  // Reset saat visible
  useEffect(() => {
    if (visible) {
      setIndex(0);
      setLayout(null);
    }
  }, [visible]);

  // ✅ Notify parent saat step berubah — untuk auto-scroll
  useEffect(() => {
    if (!visible) return;
    if (typeof onStepChange === 'function') {
      onStepChange(index);
    }
  }, [index, visible]);

  // Measure target
  useEffect(() => {
    if (!visible) return;
    const step = steps[index];
    if (!step || !step.ref) return;

    let cancelled = false;
    setMeasuring(true);

    const tryMeasure = (attempt = 0) => {
      if (cancelled) return;

      const node = step.ref.current;
      if (!node) {
        if (attempt < 10) {
          setTimeout(() => tryMeasure(attempt + 1), 250);
        } else {
          setMeasuring(false);
        }
        return;
      }

      try {
        node.measure((x, y, width, height, pageX, pageY) => {
          if (cancelled) return;

          const absX = typeof pageX === 'number' ? pageX : x;
          const absY = typeof pageY === 'number' ? pageY : y;

          if (width > 0 && height > 0 && absY >= 0 && absY < SH) {
            setLayout({ x: absX, y: absY, w: width, h: height });
            setMeasuring(false);
          } else if (attempt < 10) {
            // Masih di luar viewport — tunggu scroll selesai
            setTimeout(() => tryMeasure(attempt + 1), 300);
          } else {
            setMeasuring(false);
          }
        });
      } catch (e) {
        if (attempt < 10) {
          setTimeout(() => tryMeasure(attempt + 1), 250);
        } else {
          setMeasuring(false);
        }
      }
    };

    // Delay lebih lama — biar auto-scroll selesai dulu
    const t = setTimeout(() => tryMeasure(0), 700);

    return () => {
      cancelled = true;
      clearTimeout(t);
    };
  }, [index, visible, steps]);

  const goNext = () => {
    if (index < steps.length - 1) {
      setLayout(null);
      setIndex(index + 1);
    } else {
      onFinish?.();
    }
  };

  const goPrev = () => {
    if (index > 0) {
      setLayout(null);
      setIndex(index - 1);
    }
  };

  if (!visible) return null;

  const step = steps[index];
  if (!step) return null;

  const PAD = 8;
  const hasHole = !!layout;

  // Tooltip position
  let tooltipTop = SH / 2 - 150;
  if (hasHole) {
    const isBottomHalf = layout.y > SH / 2;
    tooltipTop = isBottomHalf
      ? Math.max(insets.top + 20, layout.y - 240)
      : Math.min(SH - 280, layout.y + layout.h + 20);
  }

  return (
    <View style={StyleSheet.absoluteFill} pointerEvents="box-none">
      {/* OVERLAY */}
      {hasHole ? (
        <>
          <View style={[styles.dark, { left: 0, right: 0, top: 0, height: Math.max(0, layout.y - PAD) }]} pointerEvents="none" />
          <View style={[styles.dark, { left: 0, right: 0, top: layout.y + layout.h + PAD, bottom: 0 }]} pointerEvents="none" />
          <View style={[styles.dark, { left: 0, top: layout.y - PAD, width: Math.max(0, layout.x - PAD), height: layout.h + PAD * 2 }]} pointerEvents="none" />
          <View style={[styles.dark, { left: layout.x + layout.w + PAD, right: 0, top: layout.y - PAD, height: layout.h + PAD * 2 }]} pointerEvents="none" />

          <Animated.View
            pointerEvents="none"
            style={[
              styles.ring,
              {
                left: layout.x - PAD,
                top: layout.y - PAD,
                width: layout.w + PAD * 2,
                height: layout.h + PAD * 2,
                borderColor: colors.primary,
                opacity: fadeAnim,
              },
            ]}
          />
        </>
      ) : (
        <View style={[styles.dark, StyleSheet.absoluteFill]} pointerEvents="none" />
      )}

      {/* Tap area */}
      <Pressable style={StyleSheet.absoluteFill} onPress={goNext} />

      {/* Skip button */}
      <Pressable
        onPress={onFinish}
        style={[styles.skipPill, { top: insets.top + 12 }]}
        hitSlop={10}
      >
        <Text style={styles.skipPillText}>Lewati Tur</Text>
        <Ionicons name="close" size={14} color="#fff" />
      </Pressable>

      {/* Tooltip */}
      <View
        style={[
          styles.tooltip,
          {
            top: tooltipTop,
            backgroundColor: colors.surface,
            borderColor: colors.primary,
          },
        ]}
      >
        <View style={[styles.stepBadge, { backgroundColor: colors.primary }]}>
          <Text style={styles.stepBadgeText}>{index + 1} / {steps.length}</Text>
        </View>

        <Text style={[styles.title, { color: colors.text }]}>{step.title}</Text>
        <Text style={[styles.desc, { color: colors.textMuted }]}>{step.desc}</Text>

        <View style={styles.actions}>
          {index > 0 ? (
            <Pressable
              onPress={goPrev}
              style={[styles.prevBtn, { borderColor: colors.line }]}
            >
              <Ionicons name="arrow-back" size={16} color={colors.text} />
              <Text style={[styles.prevText, { color: colors.text }]}>Kembali</Text>
            </Pressable>
          ) : (
            <View style={{ flex: 1 }} />
          )}

          <Pressable
            onPress={goNext}
            style={[styles.nextBtn, { backgroundColor: colors.primary }]}
          >
            <Text style={styles.nextText}>
              {index < steps.length - 1 ? 'Lanjut' : 'Selesai'}
            </Text>
            <Ionicons name="arrow-forward" size={16} color="#fff" />
          </Pressable>
        </View>
      </View>
    </View>
  );
}

const styles = StyleSheet.create({
  dark: {
    position: 'absolute',
    backgroundColor: 'rgba(0,0,0,0.82)',
  },
  ring: {
    position: 'absolute',
    borderWidth: 3,
    borderRadius: 14,
  },
  skipPill: {
    position: 'absolute',
    right: 16,
    flexDirection: 'row',
    alignItems: 'center',
    gap: 4,
    paddingVertical: 6,
    paddingHorizontal: 12,
    borderRadius: 999,
    backgroundColor: 'rgba(255,255,255,0.15)',
    borderWidth: 1,
    borderColor: 'rgba(255,255,255,0.3)',
    zIndex: 20,
  },
  skipPillText: { color: '#fff', fontSize: 12, fontWeight: '700' },
  tooltip: {
    position: 'absolute',
    left: 20,
    right: 20,
    borderRadius: 16,
    borderWidth: 2,
    padding: 16,
    gap: 8,
    zIndex: 20,
    shadowColor: '#000',
    shadowOpacity: 0.4,
    shadowRadius: 16,
    shadowOffset: { width: 0, height: 8 },
    elevation: 12,
  },
  stepBadge: {
    alignSelf: 'flex-start',
    paddingVertical: 3,
    paddingHorizontal: 10,
    borderRadius: 999,
  },
  stepBadgeText: { color: '#fff', fontSize: 11, fontWeight: '900' },
  title: { fontSize: 17, fontWeight: '900' },
  desc: { fontSize: 13, lineHeight: 20 },
  actions: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 10,
    marginTop: 8,
  },
  prevBtn: {
    flexDirection: 'row',
    alignItems: 'center',
    gap: 6,
    paddingVertical: 10,
    paddingHorizontal: 14,
    borderRadius: 999,
    borderWidth: 1,
  },
  prevText: { fontSize: 13, fontWeight: '700' },
  nextBtn: {
    flex: 1,
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    gap: 8,
    paddingVertical: 12,
    borderRadius: 999,
  },
  nextText: { color: '#fff', fontSize: 14, fontWeight: '800' },
});
