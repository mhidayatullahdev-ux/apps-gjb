// src/components/GlobalBackground.js
import React from 'react';
import { View, StyleSheet, Dimensions, Platform } from 'react-native';
import { LinearGradient } from 'expo-linear-gradient';

import { useTheme } from '../theme';

const { width: SW, height: SH } = Dimensions.get('window');

/**
 * Background global dengan corak olahraga:
 * - Gradient subtle
 * - Lingkaran (bola basket / voli)
 * - Garis diagonal (lapangan)
 * - Grid pattern (net)
 */
export default function GlobalBackground({ children }) {
  const { colors, isDark } = useTheme();

  const patternColor = isDark ? '#FFFFFF' : '#000000';
  const opacityCircle = isDark ? 0.05 : 0.06;
  const opacityLine = isDark ? 0.035 : 0.045;
  const opacityDot = isDark ? 0.05 : 0.06;

  return (
    <View style={[styles.container, { backgroundColor: colors.base }]}>
      {/* Layer 1: Gradient */}
      <LinearGradient
        colors={
          isDark
            ? ['#0B0C10', '#101018', '#0B0C10']
            : ['#F5F6F8', '#EEF0F5', '#F5F6F8']
        }
        start={{ x: 0, y: 0 }}
        end={{ x: 1, y: 1 }}
        style={StyleSheet.absoluteFill}
        pointerEvents="none"
      />

      {/* Layer 2: Corak olahraga */}
      <View style={StyleSheet.absoluteFill} pointerEvents="none">
        {/* Big circle outline — top right (bola basket) */}
        <View style={[
          styles.circle,
          {
            width: 340, height: 340, borderRadius: 170,
            top: -140, right: -160,
            borderWidth: 2,
            borderColor: colors.primary,
            opacity: opacityCircle,
          },
        ]} />

        {/* Circle solid — top right (isi bola) */}
        <View style={[
          styles.circle,
          {
            width: 180, height: 180, borderRadius: 90,
            top: -60, right: -80,
            borderWidth: 1.5,
            borderColor: colors.primary,
            opacity: opacityCircle * 0.7,
          },
        ]} />

        {/* Circle — bottom left (bola voli) */}
        <View style={[
          styles.circle,
          {
            width: 220, height: 220, borderRadius: 110,
            bottom: -100, left: -100,
            borderWidth: 2,
            borderColor: colors.gold,
            opacity: opacityCircle,
          },
        ]} />

        {/* Small circle — middle right */}
        <View style={[
          styles.circle,
          {
            width: 100, height: 100, borderRadius: 50,
            top: SH * 0.55, right: -40,
            borderWidth: 1.5,
            borderColor: colors.primary,
            opacity: opacityCircle * 0.6,
          },
        ]} />

        {/* Diagonal line 1 — court marking top-left */}
        <View style={[
          styles.line,
          {
            width: 500, height: 1.5,
            top: SH * 0.08, left: -120,
            backgroundColor: patternColor,
            opacity: opacityLine,
            transform: [{ rotate: '-25deg' }],
          },
        ]} />

        {/* Diagonal line 2 — parallel */}
        <View style={[
          styles.line,
          {
            width: 500, height: 1.5,
            top: SH * 0.08, left: -120,
            backgroundColor: patternColor,
            opacity: opacityLine,
            transform: [{ rotate: '-25deg' }, { translateY: 40 }],
          },
        ]} />

        {/* Diagonal line 3 — bottom-right */}
        <View style={[
          styles.line,
          {
            width: 450, height: 1.5,
            bottom: SH * 0.25, right: -150,
            backgroundColor: colors.gold,
            opacity: opacityLine * 0.8,
            transform: [{ rotate: '-40deg' }],
          },
        ]} />

        {/* Dot grid pattern — net feel (kanan bawah) */}
        <View style={[styles.dotGrid, { top: SH * 0.6, right: -30 }]}>
          {Array.from({ length: 5 }).map((_, row) => (
            <View key={row} style={styles.dotRow}>
              {Array.from({ length: 5 }).map((_, col) => (
                <View
                  key={col}
                  style={[
                    styles.dot,
                    {
                      backgroundColor: patternColor,
                      opacity: opacityDot,
                    },
                  ]}
                />
              ))}
            </View>
          ))}
        </View>

        {/* Dot grid pattern — kiri atas */}
        <View style={[styles.dotGrid, { top: SH * 0.25, left: -20 }]}>
          {Array.from({ length: 4 }).map((_, row) => (
            <View key={row} style={styles.dotRow}>
              {Array.from({ length: 4 }).map((_, col) => (
                <View
                  key={col}
                  style={[
                    styles.dot,
                    {
                      backgroundColor: colors.primary,
                      opacity: opacityDot * 0.8,
                    },
                  ]}
                />
              ))}
            </View>
          ))}
        </View>
      </View>

      {/* Layer 3: Content */}
      <View style={styles.content}>{children}</View>
    </View>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1 },
  content: { flex: 1 },
  circle: { position: 'absolute' },
  line: { position: 'absolute' },
  dotGrid: { position: 'absolute' },
  dotRow: {
    flexDirection: 'row',
    gap: 16,
    marginBottom: 16,
  },
  dot: {
    width: 4,
    height: 4,
    borderRadius: 2,
  },
});
