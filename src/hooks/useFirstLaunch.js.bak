// src/hooks/useFirstLaunch.js
import { useEffect, useState } from 'react';
import AsyncStorage from '@react-native-async-storage/async-storage';

const KEY = 'dispora.hasSeenOnboarding';
const PRIVACY_KEY = 'dispora.privacyAccepted';

export function useFirstLaunch() {
  const [loading, setLoading] = useState(true);
  const [isFirstLaunch, setIsFirstLaunch] = useState(false);
  const [privacyAccepted, setPrivacyAccepted] = useState(false);

  useEffect(() => {
    (async () => {
      try {
        const [seen, privacy] = await Promise.all([
          AsyncStorage.getItem(KEY),
          AsyncStorage.getItem(PRIVACY_KEY),
        ]);
        setIsFirstLaunch(!seen);
        setPrivacyAccepted(!!privacy);
      } catch {
        setIsFirstLaunch(true);
      } finally {
        setLoading(false);
      }
    })();
  }, []);

  const markOnboardingDone = async () => {
    try {
      await AsyncStorage.setItem(KEY, '1');
      setIsFirstLaunch(false);
    } catch {}
  };

  const acceptPrivacy = async () => {
    try {
      await AsyncStorage.setItem(PRIVACY_KEY, '1');
      setPrivacyAccepted(true);
    } catch {}
  };

  const resetOnboarding = async () => {
    try {
      await AsyncStorage.removeItem(KEY);
      setIsFirstLaunch(true);
    } catch {}
  };

  return {
    loading,
    isFirstLaunch,
    privacyAccepted,
    markOnboardingDone,
    acceptPrivacy,
    resetOnboarding,
  };
}

export default useFirstLaunch;
