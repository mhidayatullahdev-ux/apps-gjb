import { useEffect, useState } from 'react';
import * as WebBrowser from 'expo-web-browser';
import * as Google from 'expo-auth-session/providers/google';
import { Alert } from 'react-native';

import {
  GOOGLE_WEB_CLIENT_ID,
  GOOGLE_ANDROID_CLIENT_ID,
  GOOGLE_IOS_CLIENT_ID,
  isGoogleConfigured,
} from '../config/google';
import { useAuth } from '../context/AuthContext';

WebBrowser.maybeCompleteAuthSession();

export function useGoogleAuth({ onSuccess, onError } = {}) {
  const { googleLogin } = useAuth();
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState('');

  const [request, response, promptAsync] = Google.useAuthRequest({
    webClientId: GOOGLE_WEB_CLIENT_ID,
    androidClientId: GOOGLE_ANDROID_CLIENT_ID,
    iosClientId: GOOGLE_IOS_CLIENT_ID,
    scopes: ['openid', 'profile', 'email'],
  });

  useEffect(() => {
    if (response?.type === 'success') {
      handleSuccess(response);
    } else if (response?.type === 'error') {
      const errMsg = 'Login Google dibatalkan atau gagal.';
      setError(errMsg);
      setLoading(false);
      onError?.(errMsg);
    }
  }, [response]);

  const handleSuccess = async (res) => {
    setLoading(true);
    setError('');
    try {
      const { authentication, params } = res;
      const idToken = params?.id_token || authentication?.idToken;
      const accessToken = authentication?.accessToken;

      if (!idToken && !accessToken) {
        throw new Error('Token Google tidak diterima.');
      }

      const payload = idToken
        ? { id_token: idToken }
        : { access_token: accessToken };

      const result = await googleLogin(payload);
      onSuccess?.(result);
    } catch (e) {
      const msg = e?.message || 'Login Google gagal.';
      setError(msg);
      onError?.(msg);
    } finally {
      setLoading(false);
    }
  };

  const promptGoogleLogin = async () => {
    setError('');

    if (!isGoogleConfigured()) {
      Alert.alert(
        'Google Sign-In belum dikonfigurasi',
        'Isi GOOGLE_*_CLIENT_ID di src/config/google.js terlebih dahulu.'
      );
      return;
    }
    if (!request) {
      Alert.alert('Tunggu sebentar', 'Menyiapkan Google Sign-In...');
      return;
    }

    setLoading(true);
    try {
      await promptAsync();
    } catch (e) {
      setLoading(false);
      setError(e.message || 'Gagal membuka Google Sign-In.');
    }
  };

  return { promptGoogleLogin, loading, error };
}
