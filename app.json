{
  "expo": {
    "name": "Gelanggang Jakbar",
    "slug": "dispora-mobile",
    "version": "1.3.0",
    "orientation": "portrait",
    "scheme": "disporamobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0C10",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan $(PRODUCT_NAME) mengakses galeri foto Anda untuk mengunggah gambar.",
          "cameraPermission": "Izinkan $(PRODUCT_NAME) mengakses kamera Anda untuk mengambil foto.",
          "microphonePermission": false
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.425017210315-lti75pv26s2jv2vm9c243geh3ako4884"
        }
      ],
      "expo-localization"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.go.jakarta.dispora.demo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Aplikasi memerlukan akses galeri untuk mengunggah foto KTP/avatar.",
        "NSCameraUsageDescription": "Aplikasi memerlukan akses kamera untuk mengambil foto."
      }
    },
    "android": {
      "package": "id.go.jakarta.dispora.demo",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "02ddc74d-75d2-4875-ab1f-468f02714916"
      }
    },
    "owner": "dayatdev",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/02ddc74d-75d2-4875-ab1f-468f02714916"
    }
  }
}
