{
  "expo": {
    "name": "Gelanggang Jakbar",
    "slug": "dispora-mobile",
    "version": "1.2.2",
    "orientation": "portrait",
    "scheme": "disporamobile",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0C10",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0C10"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan $(PRODUCT_NAME) mengakses galeri foto Anda untuk mengunggah gambar.",
          "cameraPermission": "Izinkan $(PRODUCT_NAME) mengakses kamera Anda untuk mengambil foto."
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.425017210315-5v634vcgkn78r7j0mtph458lhg60vb0c"
        }
      ],
      "expo-localization"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.go.jakarta.dispora.demo",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "id.go.jakarta.dispora.demo",
      "versionCode": 5,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "newArchEnabled": false,
    "extra": {
      "eas": {
        "projectId": "02ddc74d-75d2-4875-ab1f-468f02714916"
      }
    },
    "owner": "dayatdev"
  }
}
