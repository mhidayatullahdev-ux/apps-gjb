{
  "cli": {
    "version": ">= 5.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      },
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "image": "ubuntu-22.04-jdk-17-ndk-r21e"
      },
      "channel": "preview",
      "environment": "preview"
    },
    "ios-simulator": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "ios-simulator",
      "environment": "preview"
    },
    "ios-device": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "channel": "ios-device",
      "environment": "preview"
    },
    "production": {
      "android": {
        "buildType": "app-bundle",
        "image": "ubuntu-22.04-jdk-17-ndk-r21e"
      },
      "ios": {},
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
